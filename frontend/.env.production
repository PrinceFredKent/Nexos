# Cloudflare Pages — set these in the Pages dashboard under Settings > Environment Variables
# DO NOT commit real secrets here.
#
# Set VITE_API_URL to your backend URL, e.g.:
#   http://localhost:8000         (for local dev via Cloudflare tunnel)
#   https://your-backend.domain   (if you host the backend elsewhere)
#
# Example (replace with your actual tunnel/backend URL):
# VITE_API_URL=https://your-backend-url.example.com
