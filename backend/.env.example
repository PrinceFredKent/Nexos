# Production-ready backend environment variables for NEXOS Health API
# Do not commit real secrets to version control.

# Database connection string
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<db>?sslmode=require"

# Auth / JWT
JWT_SECRET_KEY="your-production-jwt-secret"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email delivery (priority: Resend/Brevo -> SMTP fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER="you@example.com"
SMTP_PASSWORD="your-smtp-app-password"
SMTP_FROM="you@example.com"

# Optional HTTP email providers
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"
BREVO_API_KEY=""

# CORS and frontend
ALLOWED_ORIGINS="https://your-production-frontend.com"
FRONTEND_URL="https://your-production-frontend.com"

# Sync scheduler interval (minutes)
SYNC_INTERVAL_MINUTES=5

# Optional AI provider
GEMINI_API_KEY=""
